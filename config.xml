      font-src 'self' data: https: fonts.gstatic.com;
      media-src 'self' data: blob: https:;
      connect-src *;
      img-src 'self' data: blob: https:;
    </tizen:content-security-policy>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
